{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@theory-fighter-network/feature": ["./libs/app/feature/src/index.ts"],
      "@theory-fighter-network/data": ["./libs/app/data/src/index.ts"],
      "@theory-fighter-network/ui": ["./libs/app/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
